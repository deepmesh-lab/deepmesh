# true(기본값)면 브라우저 안의 목 데이터로 동작한다.
# 백엔드가 준비되면 false로 바꾸는 것만으로 실제 API에 연결된다.
VITE_USE_MOCK=false

# 조회할 네임스페이스. 이 프로젝트의 k8s 매니페스트는 전부 deepmesh에 배포된다.
# (명세의 API 기본값은 default지만 이 클러스터에는 해당 네임스페이스가 없다)
VITE_DASHBOARD_NAMESPACE=deepmesh

# 개발 서버 프록시가 /dashboard 요청을 넘길 백엔드 주소.
# 앱은 같은 오리진으로 요청하므로 백엔드에 CORS 설정이 필요 없다. (권장)
DASHBOARD_BACKEND_ORIGIN=http://localhost:8080

# 앱이 백엔드를 절대 URL로 직접 호출하게 만든다. 채우면 위 프록시를 타지 않으므로
# 백엔드에 CORS(EventSource 포함) 설정이 필요하다. 보통은 비워둔다.
VITE_DASHBOARD_API_URL=
